{
  "name": "remote-agent",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "node",
  "containerEnv": {
    "GH_CONFIG_DIR": "/home/node/.config/gh"
  },
  "remoteEnv": {
    "PATH": "${localEnv:HOME}/.codex/packages/standalone/current/bin:${containerEnv:PATH}"
  },
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "mounts": [
    "source=${localEnv:HOME}/.codex/packages/standalone,target=${localEnv:HOME}/.codex/packages/standalone,type=bind,readonly",
    "source=${localEnv:HOME}/.codex/auth.json,target=/home/node/.codex/auth.json,type=bind",
    "source=${localEnv:HOME}/.claude/.credentials.json,target=/home/node/.claude/.credentials.json,type=bind",
    "source=${localEnv:HOME}/.config/gh,target=/home/node/.config/gh,type=bind"
  ],
  "initializeCommand": "bash .devcontainer/scripts/ensure-host-codex-install.sh '${localEnv:HOME}/.codex/packages/standalone' && bash .devcontainer/scripts/ensure-host-codex-auth.sh '${localEnv:HOME}/.codex/auth.json' && bash .devcontainer/scripts/ensure-host-claude-auth.sh '${localEnv:HOME}/.claude/.credentials.json' && bash .devcontainer/scripts/ensure-host-gh-config.sh '${localEnv:HOME}/.config/gh'",
  "postCreateCommand": "bash .devcontainer/scripts/ensure-claude-onboarding.sh && corepack pnpm install --frozen-lockfile",
  "forwardPorts": [1355],
  "portsAttributes": {
    "1355": {
      "label": "Portless proxy"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode", "openai.chatgpt", "TypeScriptTeam.native-preview"]
    }
  }
}
